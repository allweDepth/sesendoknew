Options -Indexes

DirectoryIndex public/index.php

RewriteEngine On

# Tolak akses langsung ke folder internal/sensitif
RewriteRule ^(?:\.git|\.vscode|app|bin|config|database|docs|node_modules|routes|scripts|storage|tests|tmp|vendor)(?:/|$) - [F,L,NC]

# Tolak file sensitif
<FilesMatch "(^\.|\.env|\.sql$|\.log$|\.ini$|composer\.(json|lock)$|package(-lock)?\.json$)">
    Require all denied
</FilesMatch>

# Assets publik
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# File/folder nyata yang aman tetap dapat dilayani
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Front controller aplikasi
RewriteRule ^ public/index.php [QSA,L]
